	(text "C128D dongle: ESP32-S3, USB and power.  +5V_KB is the 128D's 5 V on DB25 pin 4; +5V_SYS is its OR with\nthe USB-C's VBUS; +3V3 feeds the ESP32 and the CH442E.  The CH442E routes the S3's one USB port to the\nUSB-C (device: the Mac app and flashing) or the USB-A (host: a USB keyboard).  See docs/wireless-128d.md."
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "64bb0ab9-ffb5-5315-97d6-34bb08ab26e0")
	)
