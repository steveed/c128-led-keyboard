(version 1)

# J1, the USB-C receptacle: its datasheet's land pattern puts the A1/B12 and A4/B9 pads
# 0.165 and 0.20 mm from the two locating-peg NPTHs, under the board's 0.25 mm hole
# clearance.  The pattern is the maker's own, so allow it for J1's own pads and holes only.
(rule "J1 pads to its locating pegs"
	(constraint hole_clearance (min 0.15mm))
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))
